# dsp-agc-vectors v1
# agc-config-32k: 32 kHz, hop 256, 16 bands, groups 0-4, 5-10, 11-15, dB floor -80; time constant 1.5 s, minimum range 18 dB, noise gate 20 dB below a reference that relaxes over 10 s
# expected values: tools/dsp-agc-vectors.py (independent oracle); floats are shortest round-trip decimal
config sample_rate_hz 32000
config hop_samples 256
config spectrum_bands 16
config fft_window_samples 1024
config spectrum_min_hz 50.0
config spectrum_max_hz 12000.0
config db_floor -80.0
config onset_band_groups 0-4,5-10,11-15
agc_config time_constant_s 1.5
agc_config min_range_db 18.0
agc_config gate_db 20.0
agc_config reference_time_constant_s 10.0
# in spectrum[16] (each value n / 256)
