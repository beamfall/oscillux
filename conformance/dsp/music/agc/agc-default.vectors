# dsp-agc-vectors v1
# agc-default: default configuration (24 bands, groups 0-7, 8-15, 16-23), default normaliser; beats, the same 30 dB quieter (half gated), silence, a steady level, a moving peak, then quiet hiss (-87 to -81 dB) under the noise gate
# expected values: tools/dsp-agc-vectors.py (independent oracle); floats are shortest round-trip decimal
config sample_rate_hz 48000
config hop_samples 512
config spectrum_bands 24
config db_floor -90.0
config onset_band_groups 0-7,8-15,16-23
agc_config time_constant_s 4.0
agc_config min_range_db 12.0
agc_config gate_db 36.0
agc_config reference_time_constant_s 600.0
