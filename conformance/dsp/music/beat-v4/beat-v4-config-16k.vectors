# dsp-beat-vectors v2
# beat-v4-config-16k: behaviour version 4, 16 kHz, hop 256 (62.5 frames/s, spectrum lag 5 frames), 16 bands, low group 0-4, 60-200 BPM, 3/4; 90 BPM, then 174 BPM from frame 1000; gap at frame 1500
# expected values: tools/dsp-beat-v4-vectors.py (independent oracle); floats are shortest round-trip decimal
config behavior_version 4
config sample_rate_hz 16000
config hop_samples 256
config spectrum_bands 16
config fft_window_samples 1024
config spectrum_min_hz 50.0
config spectrum_max_hz 7000.0
config onset_band_groups 0-4,5-10,11-15
beat_config min_bpm 60.0
beat_config max_bpm 200.0
beat_config beats_per_bar 3
