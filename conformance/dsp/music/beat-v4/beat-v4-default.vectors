# dsp-beat-vectors v2
# beat-v4-default: behaviour version 4, default configuration (93.75 frames/s, spectrum lag 8 frames), 60-200 BPM, 4/4; 120 BPM, then 140 BPM from frame 900; gap and stall at frame 1500; silence over frames 1600-1899; 100 BPM after it
# expected values: tools/dsp-beat-v4-vectors.py (independent oracle); floats are shortest round-trip decimal
config behavior_version 4
config sample_rate_hz 48000
config hop_samples 512
config spectrum_bands 24
config onset_band_groups 0-7,8-15,16-23
beat_config min_bpm 60.0
beat_config max_bpm 200.0
beat_config beats_per_bar 4
# in flags onset_low onset_mid onset_high spectrum[24] (each value n / 256)
