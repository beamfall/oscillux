# dsp-beat-vectors v1
# beat-config-32k: 32 kHz, hop 256 (125 frames/s), 16 bands, low group 0-4, 60-120 BPM, 3/4; 90 BPM, then 105 BPM from frame 1000; gap at frame 1400
# expected values: tools/dsp-beat-vectors.py (independent oracle); floats are shortest round-trip decimal
config sample_rate_hz 32000
config hop_samples 256
config spectrum_bands 16
config fft_window_samples 1024
config spectrum_min_hz 50.0
config spectrum_max_hz 12000.0
config onset_band_groups 0-4,5-10,11-15
beat_config min_bpm 60.0
beat_config max_bpm 120.0
beat_config beats_per_bar 3
