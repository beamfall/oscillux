# dsp-beat-vectors v2
# beat-v3-default: behaviour version 3, default configuration (93.75 frames/s), 60-200 BPM, 4/4; 120 BPM, then 100 BPM from frame 1500; gap and stall at frame 2400; silence over frames 2700-3799, after which it holds double tempo for a few seconds
# expected values: tools/dsp-beat-vectors.py (independent oracle); floats are shortest round-trip decimal
config behavior_version 3
config sample_rate_hz 48000
config hop_samples 512
config spectrum_bands 24
config onset_band_groups 0-7,8-15,16-23
beat_config min_bpm 60.0
beat_config max_bpm 200.0
beat_config beats_per_bar 4
